<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Foro Institucional - Santo Tomás</title>
  <link id="theme-style" rel="stylesheet" href="css/login.css">
</head>
<body>
  <header class="header">
    <div class="logo">
      <img src="img/logo_santotomas1.png" alt="Santo Tomás">
    </div>

    <div class="header-right">
      <span id="clima">Cargando clima...</span>
      <button id="modo-btn" title="Cambiar modo">🌙</button>
    </div>
  </header>

  <main class="main">
    <div class="login-box">
      <h2>Bienvenido</h2>
      <p>Inicia sesión en tu cuenta</p>

      <!-- Formulario POST al backend -->
      <form action="/autenticar" method="POST">
        <input type="email" name="usuario" placeholder="Correo" required>
        <input type="password" name="clave" placeholder="Contraseña" required>
        <button type="submit">Iniciar sesión</button>
      </form>

      <!-- Mostrar mensaje de error si existe -->
      <% if (error) { %>
        <p class="error" style="color: red; margin-top: 10px;"><%= error %></p>
      <% } %>

      <div class="links">
        <a href="#">¿Olvidaste tu contraseña?</a>
        <!-- Redirigir a la ruta de registro -->
        <a href="/registrar">Crear una cuenta</a>
      </div>
    </div>
  </main>

  <footer class="footer">
    © 2025 Voces Tomasinas - Foro Institucional Santo Tomás
  </footer>

  <script src="js/clima.js"></script>
</body>
</html>
