<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cerrar sesión - Voces Tomasinas</title>
  <link rel="stylesheet" href="css/cerrar.css">
</head>
<body>
  <div class="confirm-box">
    <h2>¿Estás segura de que deseas cerrar sesión?</h2>
    <p>Serás redirigida al inicio de sesión.</p>
    <div class="buttons">
      <!-- Sí cierra sesión y va a login.html -->
      <a href="login.html" class="btn confirm">Sí, cerrar sesión</a>
      <!-- Cancelar vuelve al inicio -->
      <a href="inicio.html" class="btn cancel">Cancelar</a>
    </div>
  </div>
</body>
</html>
