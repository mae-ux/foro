<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Voces Tomasinas - Actividades DAE</title>
  <link rel="stylesheet" href="css/actividades.css">
</head>

<body>
  <!-- Header -->
  <header class="header">
    <img src="img/logo_santotomas1.png" alt="Santo Tomás" class="logo">
    <nav class="navbar">
      <a href="/views/inicio.ejs">Inicio</a>
      <a href="tematicas.html">Temáticas</a>
      <a href="recursos.html">Recursos</a>
      <a href="actividades.html" class="active">Actividades DAE</a>
      <a href="perfil.html">Mi Perfil</a>
      <a href="login.html" class="logout">Cerrar sesión</a>
    </nav>
    <div class="header-right">
    <button id="menu-btn" class="menu-btn">☰</button> <!-- botón hamburguesa -->
  </div>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="overlay">
      <h1>Actividades DAE</h1>
      <p>Participa en eventos, talleres y convocatorias estudiantiles</p>
    </div>
  </section>

  <!-- Contenido principal -->
  <main class="main-content">
    <!-- Actividades destacadas -->
    <section class="actividades-lista">
      <h2>Próximas actividades</h2>

      <div class="actividad">
        <h3>Taller de Oratoria</h3>
        <p><strong>Fecha:</strong> 15 de octubre · 17:00 hrs · Auditorio Campus Peñalolén</p>
        <p>Mejora tu expresión oral y aprende técnicas para hablar en público con seguridad.</p>
        <div class="acciones">
          <button>📌 Inscribirme</button>
          <button>👍 Me interesa (18)</button>
        </div>
      </div>

      <div class="actividad">
        <h3>Jornada de Bienestar Estudiantil</h3>
        <p><strong>Fecha:</strong> 20 de octubre · 10:00 hrs · Patio Central</p>
        <p>Charlas, stands y actividades para el autocuidado, salud mental y apoyo académico.</p>
        <div class="acciones">
          <button>📌 Inscribirme</button>
          <button>👍 Me interesa (25)</button>
        </div>
      </div>

      <div class="actividad">
        <h3>Convocatoria de Voluntariado</h3>
        <p><strong>Fecha límite:</strong> 25 de octubre · Inscripción online</p>
        <p>Únete a proyectos sociales y comunitarios organizados por la DAE.</p>
        <div class="acciones">
          <button>📌 Inscribirme</button>
          <button>👍 Me interesa (32)</button>
        </div>
      </div>
    </section>

    <!-- Editor de participación -->
    <section class="editor">
      <h3>¿Quieres dejar un comentario o sugerencia?</h3>
      <textarea rows="4" placeholder="Escribe tu mensaje para la DAE..."></textarea>
      <div class="editor-actions">
        <button class="btn-primary">Enviar</button>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    © 2025 Voces Tomasinas - Foro Institucional Santo Tomás
  </footer>
  <script src="js/alternar.js"></script>
</body>
</html>